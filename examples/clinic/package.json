{
  "name": "@kalangu/example-clinic",
  "version": "0.0.0",
  "private": true,
  "description": "Example Kalangu agent: a clinic line on USSD and SMS, with a fake slow nurse model or a local Ollama model.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "node dist/demo.js",
    "start": "node dist/server.js",
    "smoke": "node dist/smoke.js"
  },
  "dependencies": {
    "@kalangu/core": "workspace:*",
    "@kalangu/sim": "workspace:*",
    "@kalangu/sms": "workspace:*",
    "@kalangu/ussd": "workspace:*"
  }
}
