{
  "name": "kalangu",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Agents for every phone, not just smartphones. A TypeScript toolkit for building AI agents on USSD and SMS, with WhatsApp, voice and mobile money on the roadmap.",
  "keywords": [
    "ussd",
    "sms",
    "whatsapp",
    "mobile-money",
    "agents",
    "ai",
    "africa",
    "conversational"
  ],
  "license": "MIT",
  "author": "Abdoullah Ndao",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "demo": "pnpm build && pnpm --filter @kalangu/example-clinic demo",
    "smoke": "pnpm --filter @kalangu/example-clinic smoke",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "site:build": "node scripts/build-site.mjs",
    "site:check": "node scripts/build-site.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "marked": "18.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
