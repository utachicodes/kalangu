{
  "name": "@kalangu/sim",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Terminal keypad-phone simulator for Kalangu agents. No gateway, no network.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kalangu/core": "workspace:*"
  }
}
