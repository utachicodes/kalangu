{
  "name": "@kalangu/core",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Turn types, budgeter, engine and sessions for Kalangu agents. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "bin": {
    "kalangu": "./dist/cli.js"
  }
}
